---
import { Icon } from 'astro-icon/components';
import localData from '../data/home.json';
import { resolveAssetImage } from '../utils/images';
import { Image } from 'astro:assets';
import { url } from '../utils/url';

//Data Definitions
interface Social {
  name: string;
  url: string;
  icon: string;
}

interface ProfileData {
  name: string;
  photoUrl: string;
  description: string;
  descriptionHtml: string;
  resumeUrl: string;
  jobTitle?: string;
  location?: string;
  availability?: string;
  socials: Social[];
}

const isApiLive = import.meta.env.PROD; // Auto true in production
const BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;

let data: ProfileData; // data as ProfileData

if (isApiLive && BASE_URL) {
  try {
    const response = await fetch(`${BASE_URL}/home`);
    if (!response.ok) throw new Error('Network response was not ok');
    data = await response.json();
  } catch (error) {
    console.error("API Fetch failed, falling back to mock data", error);
    data = localData as ProfileData;
  }
} else {
  data = localData as ProfileData;
}

const { name, photoUrl, description, descriptionHtml, resumeUrl, jobTitle, location, availability, socials } = data;
const profileImage = await resolveAssetImage(photoUrl);
---

<section id="home" class="flex flex-col items-center justify-center section-container md:pt-30 gap-1 min-h-[80vh] text-center">
  <div class="relative group mb-2 reveal-content" style="animation-delay: 100ms;">
    <div class="balloon-float w-24 h-24 rounded-full border-2 border-accent overflow-hidden shadow-[0_0_50px_color-mix(in_srgb,var(--color-accent)_33%,transparent)]">
      <!-- Use Astro Image tag for optimization, fallback to img-->
      {profileImage ? (
        <Image
          src={profileImage}
          alt={name}
          width={400}
          height={400}
          class="w-full h-full object-cover scale-110"
          loading="eager"
        />
      ) : (
        <img
          src={photoUrl ? url(photoUrl) : url('/placeholder.jpeg')}
          alt={name}
          class="w-full h-full object-cover scale-110"
          onerror={`this.onerror=null;this.src='${url('/placeholder.jpeg')}';`}
          loading="eager"
        />
      )}
    </div>
    <div class="balloon-float absolute -z-10 top-0 left-0 w-full h-full bg-accent rounded-full blur-[80px] opacity-20"></div>
  </div>

    <div class="reveal-content" style="animation-delay: 200ms;">
    <p class="font-body font-light text-gray leading-relaxed">
      <!--Hello, I'm-->
    </p>
  </div>

  <div class="px-6 sm:px-14 md:px-18 lg:px-40 max-w-360 mx-auto relative z-0 reveal-content" style="animation-delay: 300ms;">
    <h1 class="text-3xl md:text-5xl font-heading font-bold text-maintext tracking-tight">
      {name}
    </h1>
    {jobTitle && (
      <div class="font-mono text-sm text-accent/80 uppercase tracking-[0.2em] mt-4 flex items-center justify-center gap-3">
        {jobTitle}
      </div>
    )}
    {(location || availability) && (
      <div class="flex items-center justify-center gap-4 mt-2 flex-wrap">
        {location && (
          <span class="inline-flex items-center gap-1 text-xs text-subtext">
            <Icon name="mdi:map-marker" class="w-3.5 h-3.5 text-accent/60" />
            {location}
          </span>
        )}
        {availability && (
          <span class="inline-flex items-center gap-1.5 text-xs text-emerald-400 font-medium">
            <span class="relative flex w-2 h-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full w-2 h-2 bg-emerald-400"></span>
            </span>
            {availability}
          </span>
        )}
      </div>
    )}
    <p 
      class="text-gray font-body text-lg leading-relaxed mt-6" 
      set:html={descriptionHtml || description} 
    />
  </div>

  <!-- Code terminal -->
  <div class="code-terminal mt-10 mb-4 reveal-content" style="animation-delay: 600ms;">
    <div class="code-terminal-header">
      <span class="code-terminal-tab">
        <span class="code-terminal-tab-dot"></span>
        <span class="code-terminal-filename" id="code-terminal-filename">hello.c</span>
      </span>
    </div>
    <pre class="code-terminal-body"><code id="typewriter"></code></pre>
  </div>

  <div class="mt-8 mb-4 reveal-content" style="animation-delay: 400ms;">
    <a 
      href={resumeUrl} 
      target="_blank" 
      rel="noopener noreferrer"
      class="group relative inline-flex items-center justify-center px-10 py-2 bg-white/5 border border-white/10 rounded-full text-maintext font-body transition-all duration-300

             <!-- /* Mobile: Always active */ -->
             border-accent/50 bg-accent/10 shadow-[0_0_20px_rgba(var(--accent-rgb),0.3)]
             
             <!-- /* Desktop: Reset and hover */ -->
             md:border-accent/50 md:bg-accent/10 md:shadow-none md:hover:border-accent/50 md:hover:bg-accent/10 md:hover:shadow-[0_0_20px_rgba(var(--accent-rgb),0.3)] 
             hover:scale-105"
    >
      <div class="flex flex-col items-center justify-center text-center">
        <span class="tracking-wide text-sm md:text-base font-medium transition-transform duration-300 md:translate-y-2 md:group-hover:translate-y-0">
          Резюме
        </span>
        
        <span class="text-[10px] text-subtext font-light whitespace-nowrap transition-all duration-300 
                     /* Mobile: Always visible */
                     opacity-100 translate-y-0 
                     /* Desktop: Hidden until hover */
                     md:opacity-0 md:translate-y-1 md:group-hover:opacity-100 md:group-hover:translate-y-0">
          Скачать
        </span>
      </div>
    
      <div class="absolute inset-0 rounded-full blur-md bg-accent/20 -z-10 opacity-100 md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-500"></div>
    </a>
  </div>

  <div class="flex gap-6 mt-4 mb-8 reveal-content" style="animation-delay: 500ms;">
    {socials.filter((social) => social.url && social.url !== "#" && social.url !== "").map((social) => (
      <a 
        href={social.url} 
        target="_blank"
        rel="noopener noreferrer"
        class="group relative flex flex-col items-center justify-center transition-all duration-300 hover:scale-110"
      >
        <Icon 
        name={social.icon} 
        class="w-8 h-8 text-maintext group-hover:text-accent transition-colors duration-300" 
      />

      <span class="absolute -bottom-6 scale-0 opacity-0 group-hover:scale-100 group-hover:opacity-100 transition-all duration-300 text-xs text-accent font-body">
        {social.name}
      </span>
      </a>
    ))}
  </div>
</section>


<style is:global>
  .reveal-content {
    opacity: 0;
    transform: translateY(20px);
    animation: revealIn 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes revealIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* profile photo floating animation */

  /* When combined, the animation rule automatically merges these transforms */
  .avatar-container {
    animation: float 5s ease-in-out infinite alternate, wobble 7s ease-in-out infinite alternate;
  }

  .balloon-float {
    animation: floating-balloon 8s ease-in-out infinite;
  }

  @keyframes floating-balloon {
    0% {
      transform: translate(0, 0) rotate(0deg);
    }
    33% {
      /* Moves up and slightly right */
      transform: translate(3px, -8px) rotate(1deg);
    }
    66% {
      /* Drifts left and stays elevated */
      transform: translate(-3px, -4px) rotate(-1deg);
    }
    100% {
      /* Returns to start */
      transform: translate(0, 0) rotate(0deg);
    }
  }

  /* === Code terminal === */
  .code-terminal {
    width: 100%;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--color-accent) 20%, transparent);
    background: color-mix(in srgb, var(--color-background) 65%, transparent);
    backdrop-filter: blur(6px);
    overflow: hidden;
    box-shadow: 0 10px 40px color-mix(in srgb, var(--color-accent) 8%, transparent);
    text-align: left;
  }

  .code-terminal-header {
    display: flex;
    align-items: center;
    padding: 8px 14px 0 14px;
    background: transparent;
    border-bottom: 1px solid color-mix(in srgb, var(--color-accent) 15%, transparent);
  }

  .code-terminal-tab {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    border-top: 2px solid var(--color-accent);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-family: var(--font-heading);
    font-size: 11px;
    color: var(--color-maintext);
  }

  .code-terminal-tab-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.7;
  }

  .code-terminal-filename {
    margin-left: auto;
    font-family: var(--font-heading);
    font-size: 11px;
    letter-spacing: 0.05em;
    color: var(--color-subtext);
  }

  .code-terminal-body {
    margin: 0;
    padding: 18px 20px;
    min-height: 170px;
    font-family: ui-monospace, "JetBrains Mono", "Fira Code", "Cascadia Code", monospace;
    font-size: 13px;
    line-height: 1.65;
    color: var(--color-maintext);
    white-space: pre;
    overflow-x: auto;
    transition: opacity 0.4s ease;
  }
  .code-terminal-body.fading {
    opacity: 0;
  }

  #typewriter::after {
    content: "▍";
    color: var(--color-accent);
    margin-left: 1px;
    animation: caret-blink 1s steps(2, start) infinite;
  }

  @keyframes caret-blink {
    0%, 50% { opacity: 1; }
    50.01%, 100% { opacity: 0; }
  }

  /* === Syntax colors — dark === */
  [data-theme$="-dark"] .tok-kw      { color: #ff79c6; }
  [data-theme$="-dark"] .tok-str     { color: #50fa7b; }
  [data-theme$="-dark"] .tok-fn      { color: #8be9fd; }
  [data-theme$="-dark"] .tok-pre     { color: #f1fa8c; }
  [data-theme$="-dark"] .tok-comment { color: #6272a4; }

  /* === Syntax colors — light === */
  [data-theme$="-light"] .tok-kw      { color: #a626a4; }
  [data-theme$="-light"] .tok-str     { color: #50a14f; }
  [data-theme$="-light"] .tok-fn      { color: #4078f2; }
  [data-theme$="-light"] .tok-pre     { color: #c18401; }
  [data-theme$="-light"] .tok-comment { color: #a0a1a7; }

  /* Respect reduce motion — мигающий курсор отключаем */
  @media (prefers-reduced-motion: reduce) {
    #typewriter::after { animation: none; opacity: 1; }
  }
</style>

<script>
  interface Token { t: string; c?: string }
  interface Sample { filename: string; tokens: Token[] }

  const samples: Sample[] = [
    {
      filename: "hello.c",
      tokens: [
        { t: "#include <stdio.h>\n", c: "tok-pre" },
        { t: "int", c: "tok-kw" },
        { t: " main(", c: "" },
        { t: "void", c: "tok-kw" },
        { t: ") {\n  ", c: "" },
        { t: "printf", c: "tok-fn" },
        { t: "(", c: "" },
        { t: '"Hello, World!\\n"', c: "tok-str" },
        { t: ");\n  ", c: "" },
        { t: "return", c: "tok-kw" },
        { t: " 0;\n}", c: "" },
      ],
    },
    {
      filename: "hello.cpp",
      tokens: [
        { t: "#include <iostream>\n", c: "tok-pre" },
        { t: "int", c: "tok-kw" },
        { t: " main(", c: "" },
        { t: "void", c: "tok-kw" },
        { t: ") {\n  std::cout << ", c: "" },
        { t: '"Hello, World!"', c: "tok-str" },
        { t: " << std::endl;\n  ", c: "" },
        { t: "return", c: "tok-kw" },
        { t: " 0;\n}", c: "" },
      ],
    },
    {
      filename: "hello.py",
      tokens: [
        { t: "def", c: "tok-kw" },
        { t: " main():\n    ", c: "" },
        { t: "print", c: "tok-fn" },
        { t: "(", c: "" },
        { t: '"Hello, World!"', c: "tok-str" },
        { t: ")\n\n", c: "" },
        { t: "if", c: "tok-kw" },
        { t: " __name__ == ", c: "" },
        { t: '"__main__"', c: "tok-str" },
        { t: ":\n    main()", c: "" },
      ],
    },
  ];

  function prefersReducedMotion(): boolean {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function renderSampleStatic(sample: Sample, target: HTMLElement) {
    target.innerHTML = "";
    for (const tk of sample.tokens) {
      if (tk.c) {
        const span = document.createElement("span");
        span.className = tk.c;
        span.textContent = tk.t;
        target.appendChild(span);
      } else {
        target.appendChild(document.createTextNode(tk.t));
      }
    }
  }

  function typeSample(
    sample: Sample,
    target: HTMLElement,
    filenameEl: HTMLElement | null
  ): Promise<void> {
    return new Promise((resolve) => {
      if (filenameEl) filenameEl.textContent = sample.filename;
      target.innerHTML = "";

      let tokenIdx = 0;
      let charIdx = 0;
      let currentSpan: HTMLSpanElement | null = null;

      const step = () => {
        if (tokenIdx >= sample.tokens.length) {
          setTimeout(resolve, 3000);
          return;
        }

        const token = sample.tokens[tokenIdx];

        if (charIdx === 0) {
          if (token.c) {
            currentSpan = document.createElement("span");
            currentSpan.className = token.c;
            target.appendChild(currentSpan);
          } else {
            currentSpan = null;
          }
        }

        const ch = token.t[charIdx];
        const node: Node = currentSpan ?? target;
        node.appendChild(document.createTextNode(ch));

        charIdx++;
        if (charIdx >= token.t.length) {
          tokenIdx++;
          charIdx = 0;
        }

        let delay = 60 + Math.random() * 80; // 40–100 мс

        // После знаков препинания — небольшая пауза
        if (ch === '\n') delay += 120;                    // новая строка
        if ('.,;:'.includes(ch)) delay += 60;             // пунктуация
        if (ch === ' ') delay -= 8;                       // пробел — чуть быстрее

        setTimeout(step, Math.max(0, delay));
      };

      step();
    });
  }

  function fadeOutClear(target: HTMLElement): Promise<void> {
    return new Promise((resolve) => {
      target.classList.add("fading");
      setTimeout(() => {
        target.innerHTML = "";
        target.classList.remove("fading");
        resolve();
      }, 420);
    });
  }

  async function runTypewriter() {
    const target = document.getElementById("typewriter");
    const filenameEl = document.getElementById("code-terminal-filename");
    if (!target || !filenameEl) return;

    if (prefersReducedMotion()) {
      renderSampleStatic(samples[0], target);
      if (filenameEl) filenameEl.textContent = samples[0].filename;
      return;
    }

    let idx = 0;
    // небольшой стартовый отступ, чтобы reveal-content отыграл
    await new Promise((r) => setTimeout(r, 800));

    while (true) {
      const sample = samples[idx % samples.length];
      await typeSample(sample, target, filenameEl);
      await fadeOutClear(target);
      idx++;
    }
  }

  function initTypewriter() {
    // отменяем предыдущий цикл на случай повторного вызова
    runTypewriter();
  }

  initTypewriter();
  document.addEventListener("astro:after-swap", initTypewriter);
</script>