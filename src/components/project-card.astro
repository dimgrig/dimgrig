---
import { Icon } from 'astro-icon/components';
const { project } = Astro.props;
import { Image } from 'astro:assets';
import { resolveAssetImage } from '../utils/images';
import { getProjectCategories } from '../utils/project-meta';
import { url } from '../utils/url';

// Map through the array of image strings from project JSON
const optimizedImages = await Promise.all(
  project.images.map(async (imgName: string) => {
    return await resolveAssetImage(imgName);
  })
);

const validImages = optimizedImages.filter(Boolean);
const isSlider = validImages.length > 1;

const cats = getProjectCategories(project.category);

const platformLabels: Record<string, string> = {
  'Устройство':'Устройство',
  'ПО':        'ПО'
};

const platformIconMap: Record<string, string> = {
  'Устройство':'mdi:developer-board',
  'ПО':        'mdi:code'
};
---

<div class="project-card group relative bg-accent/5 border border-accent/10 rounded-2xl overflow-hidden hover:border-accent/40 transition-all duration-500 flex flex-col">

  <!-- Image area -->
  <div class="aspect-[4/3] overflow-hidden relative bg-background/50 shrink-0">

    <!-- Blurred backdrop — заполняет поля за картинкой -->
    {validImages.length > 0 && (
      <Image
        src={validImages[0]}
        alt=""
        aria-hidden="true"
        width={80}
        format="webp"
        quality={30}
        class="absolute inset-0 w-full h-full object-cover scale-125 blur-2xl opacity-60 z-0"
      />
    )}

    <!-- 1. Кликабельная ссылка — покрывает всю область, самый низкий z-index -->
    <a
      href={url(`/projects/${project.slug}/`)}
      class="absolute inset-0 z-10 block"
      aria-label={`Открыть проект: ${project.title}`}
    >
      <div class={`w-full h-full relative ${isSlider ? 'image-slider' : ''}`}>
        {validImages.length > 0 ? (
          validImages.map((imgMetadata, index) => (
            <Image
              src={imgMetadata}
              alt={project.title}
              class={`absolute inset-0 w-full h-full object-contain transition-all duration-1000 group-hover:scale-105 ${index === 0 ? 'opacity-100 z-0' : 'opacity-0 z-[-1]'}`}
            />
          ))
        ) : (
          <img
            src={url('/placeholder.jpeg')}
            alt={`${project.title} placeholder`}
            class="absolute inset-0 w-full h-full object-contain transition-all duration-1000 group-hover:scale-105"
          />
        )}
      </div>
    </a>

    <!-- 2. Иконки платформ — поверх ссылки, некликабельны -->
    <div class="absolute top-3 right-3 flex gap-2 z-20 pointer-events-none">
      {project.platforms.map((p: string) => (
        <div class="p-1.5 bg-background/80 backdrop-blur-md rounded-lg border border-accent/10 text-maintext">
          <Icon name={platformIconMap[p] ?? `mdi:${p}`} class="w-4 h-4" />
        </div>
      ))}
    </div>

    <!-- 3. Точки-индикаторы — поверх ссылки, кликабельны -->
    {isSlider && (
      <div class="slider-dots absolute bottom-3 left-1/2 -translate-x-1/2 flex gap-1.5 z-30">
        {validImages.map((_: unknown, i: number) => (
          <button
            type="button"
            class={`slider-dot block rounded-full transition-all duration-300 cursor-pointer ${i === 0 ? 'w-4 h-1.5 bg-white' : 'w-1.5 h-1.5 bg-white/40 hover:bg-white/70'}`}
            data-index={i}
            aria-label={`Показать слайд ${i + 1}`}
          />
        ))}
      </div>
    )}
  </div>

  <!-- Card body -->
  <div class="p-6 flex flex-col gap-3 flex-1">
    <div>
      <div class="flex flex-wrap gap-1.5">
        {cats.map((c) => (
          <span class={`inline-block text-[10px] uppercase tracking-widest font-bold px-2 py-0.5 rounded-full border ${c.badgeClass}`}>
            {c.label}
          </span>
        ))}
      </div>
      <a href={url(`/projects/${project.slug}/`)} class="block group/title">
        <h3 class="text-xl font-heading font-bold text-maintext mt-2 group-hover/title:text-accent transition-colors">
          {project.title}
        </h3>
      </a>
    </div>

    <p class="text-subtext text-sm font-body line-clamp-3 flex-1">
      {project.description}
    </p>

    <div class="flex flex-wrap gap-2">
      {project.tech.map((t: string) => (
        <span class="rounded-md text-[10px] px-2 md:px-4 py-1 bg-accent/5 border border-accent/10 text-accent/80 group-hover:border-accent/40 group-hover:text-accent transition-colors duration-300">
          {t}
        </span>
      ))}
    </div>

    <!-- Two actions -->
    <div class="flex gap-2 mt-1">
      <a
        href={url(`/projects/${project.slug}/`)}
        class="flex-1 flex items-center justify-center gap-2 py-2 rounded-lg border border-accent/20 text-accent/70 hover:text-accent hover:border-accent/60 hover:bg-accent/5 transition-all text-xs font-semibold tracking-wide"
      >
        Подробнее <Icon name="mdi:arrow-right" class="w-3.5 h-3.5" />
      </a>
      {project.link && (
        <a
          href={project.link}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center px-3 py-2 rounded-lg border border-accent/20 text-accent/70 hover:text-accent hover:border-accent/60 hover:bg-accent/5 transition-all text-xs"
          title="Открыть внешний ресурс"
        >
          <Icon name="mdi:open-in-new" class="w-3.5 h-3.5" />
        </a>
      )}
    </div>
  </div>
</div>

<script>
  const activeSliderIntervals: ReturnType<typeof setInterval>[] = [];

  function initSliders() {
    activeSliderIntervals.forEach(clearInterval);
    activeSliderIntervals.length = 0;

    const sliders = document.querySelectorAll('.image-slider');

    sliders.forEach((slider) => {
      const images = slider.querySelectorAll('img');
      if (images.length <= 1) return;

      const card = slider.closest('.project-card');
      const dots = card ? card.querySelectorAll('.slider-dot') : [];

      let currentIndex = 0;
      let intervalId: ReturnType<typeof setInterval> | null = null;

      function goTo(next: number) {
        images[currentIndex].classList.remove('opacity-100', 'z-0');
        images[currentIndex].classList.add('opacity-0', 'z-[-1]');
        if (dots[currentIndex]) {
          dots[currentIndex].classList.remove('w-4', 'bg-white');
          dots[currentIndex].classList.add('w-1.5', 'bg-white/40');
        }

        currentIndex = next;

        images[currentIndex].classList.remove('opacity-0', 'z-[-1]');
        images[currentIndex].classList.add('opacity-100', 'z-0');
        if (dots[currentIndex]) {
          dots[currentIndex].classList.remove('w-1.5', 'bg-white/40');
          dots[currentIndex].classList.add('w-4', 'bg-white');
        }
      }

      function startAuto() {
        intervalId = setInterval(() => {
          goTo((currentIndex + 1) % images.length);
        }, 3500);
        if (intervalId) activeSliderIntervals.push(intervalId);
      }

      function pauseAuto() {
        if (intervalId) {
          clearInterval(intervalId);
          intervalId = null;
        }
      }

      // Клик по точке — переключаем вручную и ставим авто-цикл на паузу
      dots.forEach((dot, i) => {
        dot.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          pauseAuto();
          goTo(i);
          // опционально: возобновить авто-цикл через 8 секунд
          setTimeout(() => { if (!intervalId) startAuto(); }, 8000);
        });
      });

      startAuto();
    });
  }

  initSliders();
  document.addEventListener('astro:after-swap', () => { initSliders(); });
</script>

<style is:global>
  .project-card {
    opacity: 0;
    visibility: hidden;
    transform: translateY(40px);
    transition:
      opacity 0.8s ease-out,
      transform 0.8s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0.8s;
    will-change: transform, opacity;
  }

  .project-card.reveal {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translateY(0) !important;
  }

  /* Slider dot pill transition */
  .slider-dot {
    transition: width 0.4s ease, background-color 0.4s ease;
  }
</style>