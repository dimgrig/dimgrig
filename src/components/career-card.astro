---
import { Icon } from 'astro-icon/components';

interface ProjectEntry {
  title: string;
  note?: string;
}

interface Props {
  item: {
    period: string;
    role: string;
    company: string;
    url?: string;
    type: string;
    description?: string;
    focus?: string;
    projects?: ProjectEntry[];
    skills: string[];
  };
  variant: 'mobile' | 'desktop-left' | 'desktop-right';
}

const { item, variant } = Astro.props;

const isLeft = variant === 'desktop-left';

const alignmentClass = isLeft ? 'text-right' : '';
const skillContainerClasses = `flex flex-wrap gap-2 ${isLeft ? 'justify-end' : ''}`;

const typeColors: Record<string, string> = {
  'Полная занятость': 'text-red-400 bg-red-400/10 border-red-400/20',
  'Самозанятость':    'text-amber-400 bg-amber-400/10 border-amber-400/20',
  'Самозанятый':      'text-amber-400 bg-amber-400/10 border-amber-400/20',
  'Совместительство': 'text-emerald-400 bg-emerald-400/10 border-emerald-400/20',
  'Аспирант':         'text-violet-400 bg-violet-400/10 border-violet-400/20',
  'Студент':          'text-sky-400 bg-sky-400/10 border-sky-400/20',
};
const typeBadgeClass = typeColors[item.type] ?? 'text-accent bg-accent/10 border-accent/20';

const headerRowClass = isLeft ? 'flex-row-reverse' : 'flex-row';

// Отфильтровываем пустые записи (защита от [""])
const projects = (item.projects ?? []).filter(
  (p) => p.title && p.title.trim() !== ''
);
---

<div class={`bg-accent/5 border border-accent/10 p-4 md:p-6 rounded-2xl hover:border-accent/40 hover:shadow-[0_0_30px_color-mix(in_srgb,var(--color-accent)_10%,transparent)] hover:scale-[1.01] transition-all duration-300 group ${alignmentClass}`}>
  {/* Period + type badge */}
  <div class={`flex items-center gap-2 mb-1 ${headerRowClass}`}>
    <span class="font-mono text-xs tracking-widest uppercase text-accent/75">{item.period}</span>
    <span class={`inline-block text-[10px] uppercase tracking-widest font-bold px-2 py-0.5 rounded-full border whitespace-nowrap ${typeBadgeClass}`}>
      {item.type}
    </span>
  </div>

  {/* Role */}
  <h3 class="text-xl font-heading font-bold text-maintext mt-1">{item.role}</h3>

  {/* Company */}
  <p class="text-accent text-base font-semibold mb-3">
    {item.url ? (
      <a
        href={item.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 group/link hover:underline underline-offset-2"
      >
        {item.company}
        <Icon
          name="mdi:open-in-new"
          class="w-3.5 h-3.5 opacity-60 group-hover/link:opacity-100 transition-opacity duration-200"
        />
      </a>
    ) : item.company}
  </p>

  {/* Focus — суть роли */}
  {item.focus && (
    <p class="text-subtext font-body text-xs mb-4">{item.focus}</p>
  )}

  {/* Description — для образования */}
  {item.description && (
    <p class="text-subtext font-body text-sm leading-relaxed mb-4 text-left whitespace-pre-line">
      {item.description}
    </p>
  )}

  {/* Projects */}
  {projects.length > 0 && (
    <ul class="space-y-2 mb-4 text-left">
      {projects.map((p) => (
        <li class="flex gap-2 text-sm leading-relaxed">
          <Icon
            name="mdi:chevron-right"
            class="w-4 h-4 text-accent/60 shrink-0 mt-0.5"
          />
          <span class="min-w-0">
            <span class="text-maintext font-medium">{p.title}</span>
            {p.note && <span class="text-subtext"> — {p.note}</span>}
          </span>
        </li>
      ))}
    </ul>
  )}

  {/* Skills */}
  {item.skills && item.skills.length > 0 && (
    <div class={skillContainerClasses}>
      {item.skills.map((skill: string) => (
        <span class="rounded-md text-[10px] px-2 md:px-4 py-1 bg-accent/5 border border-accent/10 text-accent/80 group-hover:border-accent/40 group-hover:text-accent">
          {skill}
        </span>
      ))}
    </div>
  )}
</div>